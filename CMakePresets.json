{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MLX_BUILD_DIR": "$env{MLX_BUILD_DIR}",
        "BUILD_TESTING": "ON",
        "MLXPDLP_BUILD_EXAMPLES": "ON",
        "MLXPDLP_BUILD_MPS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release library",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MLX_BUILD_DIR": "$env{MLX_BUILD_DIR}",
        "BUILD_TESTING": "OFF",
        "MLXPDLP_BUILD_EXAMPLES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
